{
    admin off
    auto_https off
}

:8080 {
    # Health is independent of NextCRM boot status; never forwards to the app.
    @gateway_health path /__gateway_health
    handle @gateway_health {
        respond "ready" 200
    }

    @private_bridge path /api/internal /api/internal/*
    handle @private_bridge {
        respond "Not found" 404
    }

    handle {
        reverse_proxy {$NEXTCRM_UPSTREAM:nextcrm-web.railway.internal:3000} {
            # Railway terminates public TLS before Caddy receives HTTP. Caddy
            # otherwise overwrites X-Forwarded-Proto with "http", which may
            # cause Next.js to redirect to the backend's internal :3000 port.
            header_up Host {http.request.host}
            header_up X-Forwarded-Host {http.request.host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443

            # Defense in depth: normalize Location only for OUR public hostname.
            # Never rewrite OAuth redirects to third-party identity providers.
            header_down Location "^https?://nextcrm-gateway-staging\\.up\\.railway\\.app:3000(/.*)?$" "https://nextcrm-gateway-staging.up.railway.app$1"
            header_down Location "^http://nextcrm-gateway-staging\\.up\\.railway\\.app(/.*)?$" "https://nextcrm-gateway-staging.up.railway.app$1"

            header_up -X-Cisne-Bridge-Signature
            header_up -X-Cisne-Bridge-Nonce
            header_up -X-Cisne-Bridge-Timestamp
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }
}
