{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 0.0.0.0 --port ${PORT:-8787} --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:security": "node --experimental-strip-types --test lib/api/http-auth.test.mjs lib/api/error-diagnostics.test.mjs lib/api/staging-session.test.mjs lib/api/mutation-origin.test.mjs",
    "test:postgres-adapter": "node --test db/raw-sql.test.mjs db/postgres-query.test.mjs",
    "test:integration": "NODE_ENV=test node --import tsx --test test/integration/*.test.ts",
    "test:smoke:staging": "node test/staging-smoke.mjs",
    "test:regression:enterprise": "node test/enterprise-responsive-http-regression.mjs",
    "test": "pnpm test:security && pnpm test:postgres-adapter && pnpm test:domain && pnpm test:route-inventory && pnpm test:enterprise-contracts && pnpm test:enterprise-quality-contracts && pnpm test:typed-catalog && pnpm test:governed-actions && pnpm test:object-routes",
    "db:generate": "drizzle-kit generate",
    "test:domain": "node --experimental-strip-types --test lib/domain/purchase-order-pricing.test.mjs lib/domain/finance.test.mjs",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "test:route-inventory": "node --test test/enterprise-route-inventory.contract.test.mjs",
    "test:enterprise-contracts": "node --test test/procurement-fiscal.fail-closed.contract.test.mjs test/enterprise-transactional-journeys.synthetic.test.mjs",
    "test:enterprise-states": "node --test test/enterprise-data-state.contract.test.mjs",
    "test:enterprise-quality-contracts": "node --test test/enterprise-accessibility-isolation.contract.test.mjs",
    "test:typed-catalog": "node --test test/enterprise-typed-catalog.contract.test.mjs",
    "test:governed-actions": "node --experimental-strip-types --test test/enterprise-governed-actions.contract.test.mjs",
    "test:object-routes": "node --experimental-strip-types --test test/enterprise-object-routes.contract.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
